<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Flowamaz.Application.Workflow</RootNamespace>

    <PackageId>Flowamaz.Engine.Runtime</PackageId>
    <Version>0.1.0</Version>
    <Authors>TOOTKER SOLUTIONS PTE. LTD.</Authors>
    <Company>TOOTKER SOLUTIONS PTE. LTD.</Company>
    <Product>Flowamaz</Product>
    <Copyright>Copyright (c) 2026 TOOTKER SOLUTIONS PTE. LTD.</Copyright>
    <Description>The Flowamaz workflow runtime: durable orchestration (trigger, step, resume, cancel), saga compensation, action and human-gate workers, gate decisions, the connector execution pipeline, run entities, repository and queue contracts, and the runtime hooks a host plugs into.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/flowamaz-io/flowamaz</PackageProjectUrl>
    <RepositoryUrl>https://github.com/flowamaz-io/flowamaz</RepositoryUrl>
    <PackageTags>workflow;engine;durable-execution;saga;flowamaz</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Flowamaz.Engine.Core\Flowamaz.Engine.Core.csproj" />
    <ProjectReference Include="..\Flowamaz.Connectors.Official\Flowamaz.Connectors.Official.csproj" />
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="LICENSE" Pack="true" PackagePath="\" />
    <InternalsVisibleTo Include="Flowamaz.Engine.Runtime.Tests" />
    <!-- The product's own test suites also exercise a few internal helpers. -->
    <InternalsVisibleTo Include="Flowamaz.Tests.Unit" />
    <InternalsVisibleTo Include="Flowamaz.Tests.Integration" />
  </ItemGroup>

</Project>
