<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Flowamaz.Core</RootNamespace>

    <PackageId>Flowamaz.Connectors.Sdk</PackageId>
    <Version>0.1.0</Version>
    <Authors>Flowamaz</Authors>
    <Description>Flowamaz connector SDK: the contract every connector operation implements (IConnectorOperationHandler), credentials, actionable errors, the call context, connector manifests (ConnectorSpec), the egress guard, and the host hooks a connector may use.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/flowamaz-io/flowamaz</PackageProjectUrl>
    <RepositoryUrl>https://github.com/flowamaz-io/flowamaz</RepositoryUrl>
    <PackageTags>workflow;connectors;sdk;flowamaz</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
