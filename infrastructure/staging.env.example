# Flowamaz — STAGING environment file template.
# Copy to infrastructure/staging.env and fill in real staging values. Never commit the populated file.
#   docker compose -f infrastructure/docker-compose.staging.yml --env-file infrastructure/staging.env up -d
# All values below are placeholders. Generate secrets with the commands noted in each comment.

# ── Runtime ──────────────────────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Staging          # Forces startup secret validation (non-Development gate).

# ── Database (Postgres) ──────────────────────────────────────────────────────
DB_NAME=flowamaz_staging                # Postgres database name (compose seeds the db container).
DB_USER=flowamaz                        # Postgres user.
DB_PASSWORD=change-me-staging-db-pass   # Postgres password.
# Overridden by compose to Host=db;... — set for host-side tooling/migrations only.
DB_CONNECTION_STRING=Host=db;Port=5432;Database=flowamaz_staging;Username=flowamaz;Password=change-me-staging-db-pass

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_CONNECTION_STRING=redis:6379      # Queue, session/semantic cache, rate limiting (compose overrides to redis:6379).

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me                    # HMAC signing key, >=32 bytes. Generate: openssl rand -base64 48
JWT_ISSUER=flowamaz.io                  # Token issuer.
JWT_AUDIENCE=flowamaz-app               # Token audience.

# ── Security keys ────────────────────────────────────────────────────────────
CREDENTIAL_MASTER_KEY=change-me         # Credential vault master key (AES-GCM). Generate: openssl rand -base64 32
GATE_SIGNING_KEY=change-me              # Signs human-gate approval links. Generate: openssl rand -hex 32

# ── AI (Anthropic — only platform-managed provider) ──────────────────────────
Ai__AnthropicPlatformKey=sk-ant-staging-xxx   # Platform Anthropic key (powers F1–F7). Alt name: ANTHROPIC_PLATFORM_KEY

# ── Email (Resend) ───────────────────────────────────────────────────────────
Email__ResendApiKey=re_staging_xxx      # Resend transactional email key. Alt name: RESEND_API_KEY
EMAIL_FROM_ADDRESS=noreply@flowamaz.io  # From address for transactional mail.

# ── Billing (Stripe) ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxx           # Stripe secret key (use test-mode keys in staging).
STRIPE_WEBHOOK_SECRET=whsec_xxx         # Stripe webhook signing secret.

# ── Platform ─────────────────────────────────────────────────────────────────
Platform__BaseUrl=https://staging.flowamaz.io   # App base URL (redirect allowlist, links).
MARKETING_SITE_URL=https://staging.flowamaz.com  # Marketing site URL for cross-links.

# ── Edition ──────────────────────────────────────────────────────────────────
EDITION=pro                             # community | starter | pro | enterprise.

# ── Git versioning ───────────────────────────────────────────────────────────
GIT_REPOS_BASE_PATH=/app/data/repos     # Writable path for per-workspace bare git repos.

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://staging.flowamaz.io   # Comma-separated allowed SPA origins.

# ── Slack OAuth (connector + gate delivery) ──────────────────────────────────
SLACK_CLIENT_ID=staging-slack-client-id        # Slack OAuth app client id.
SLACK_CLIENT_SECRET=staging-slack-client-secret # Slack OAuth app client secret.
