  "Email": {
    "ResendApiKey": "",
    "FromAddress": "noreply@flowamaz.io",
    "FromName": "Flowamaz",
    "SupportEmail": "support@flowamaz.io",
    "SecurityEmail": "security@flowamaz.io"
  },
  "GitHub": {
    "ConnectorsRepo": "flowamaz-io/connectors",
    "TemplatesRepo": "flowamaz-io/templates",
    "WebhookSecret": "",
    "AppId": "",
    "AppPrivateKey": ""
  },
  "Git": {
    "ReposBasePath": "/app/data/repos"
  },
  "Library": {
    "SyncIntervalMinutes": 15
  },
  "Platform": {
    "BaseUrl": "",
    "Edition": "community"
  },
  "Community": {
    "MaxWorkflows": 5,
    "MaxRunsPerMonth": 500,
    "MaxUsers": 1
  },
  "HelpDocs": {
    "BaseUrl": "https://docs.flowamaz.io",
