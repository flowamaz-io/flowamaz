{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://flowamaz.io/schemas/workflow-v1.schema.json",
  "title": "Flowamaz Workflow v1",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "flowamaz/v1"
    },
    "kind": {
      "type": "string",
      "const": "Workflow"
    },
    "metadata": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9-]+$" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "workspace": { "type": "string" }
      }
    },
    "spec": {
      "type": "object",
      "required": ["trigger", "nodes", "edges"],
      "additionalProperties": false,
      "properties": {
        "trigger": {
          "type": "object",
          "required": ["type"],
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "enum": ["webhook", "form", "schedule", "manual", "sub-workflow"]
            },
            "config": { "type": "object" }
          }
        },
        "default_model": { "type": "string" },
        "sla_threshold_ms": { "type": "integer", "minimum": 0 },
        "variables": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": {
                "type": "string",
                "enum": ["string", "number", "boolean", "object", "array"]
              },
              "required": {},
              "sensitive": {},
              "default": {}
            }
          }
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/node" }
        },
        "edges": {
          "type": "array",
          "items": { "$ref": "#/definitions/edge" }
        },
        "groups": {
          "type": "array",
          "items": { "$ref": "#/definitions/group" }
        }
      }
    }
  },
  "definitions": {
    "node": {
      "type": "object",
      "required": ["id", "type", "label"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9-]+$" },
        "type": {
          "type": "string",
          "enum": ["action", "ai", "human-gate", "router", "end", "foreach", "parallel", "try-catch", "wait", "sub-workflow", "annotation", "trigger"]
        },
        "label": { "type": "string", "minLength": 1 },
        "config": { "type": "object" },
        "content": { "type": "string" },
        "position": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" }
          }
        },
        "retry": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_attempts": { "type": "integer", "minimum": 1, "maximum": 100 },
            "backoff_seconds": { "type": "integer", "minimum": 0 },
            "backoff_multiplier": { "type": "number", "minimum": 1.0 }
          }
        },
        "timeout": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "seconds": { "type": "integer", "minimum": 1 },
            "on_timeout": { "type": ["string", "null"] }
          }
        },
        "compensate": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "strategy": {
              "type": "string",
              "enum": ["backward", "forward", "pivot"]
            },
            "node_id": { "type": "string" }
          }
        }
      }
    },
    "edge": {
      "type": "object",
      "required": ["id", "from", "to"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "via": { "type": "string" }
      }
    },
    "group": {
      "type": "object",
      "required": ["id", "label", "node_ids"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "node_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
      }
    }
  }
}
