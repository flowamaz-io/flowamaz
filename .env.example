# Flowamaz — Environment Variables
# Copy to .env and fill in values. Never commit .env.
#
# The .NET app reads configuration via the standard ASP.NET Core binder, which uses
# double-underscore for nested keys (e.g. ConnectionStrings__DefaultConnection).
# Infrastructure.DependencyInjection reads the single-name vars (DB_CONNECTION_STRING,
# REDIS_CONNECTION_STRING) directly and falls back to the binder keys when unset, so
# either form works. Other single-name vars (JWT_SECRET, etc.) are consumed directly
# by their respective services.

# ─── Database ──────────────────────────────────────────────────────────────
# Either set the full string here…
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=flowamaz;Username=flowamaz;Password=flowamaz_dev
# …or use these and let Docker Compose / your shell assemble the connection string.
DB_CONNECTION_STRING=Host=localhost;Port=5432;Database=flowamaz;Username=flowamaz;Password=flowamaz_dev
DB_NAME=flowamaz
DB_USER=flowamaz
DB_PASSWORD=flowamaz_dev

# ─── Redis ─────────────────────────────────────────────────────────────────
ConnectionStrings__Redis=localhost:6379
REDIS_CONNECTION_STRING=localhost:6379

# ─── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated allowlist. Empty defaults to http://localhost:5173 in dev only.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ─── JWT ───────────────────────────────────────────────────────────────────
JWT_SECRET=
JWT_ISSUER=flowamaz-api
JWT_AUDIENCE=flowamaz-client
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRY_DAYS=7

# ─── AI — Platform managed keys (Anthropic only; all other providers are BYOK per §5.1) ───
ANTHROPIC_PLATFORM_KEY=

# ─── AI Cost Control ───────────────────────────────────────────────────────
AI_BUDGET_DEFAULT_MONTHLY_TOKENS=500000
AI_COPILOT_RATE_LIMIT_PER_HOUR=60
AI_SEMANTIC_CACHE_TTL_HOURS=24

# ─── Git Storage (workflow YAML repos) ─────────────────────────────────────
GIT_REPOS_BASE_PATH=/app/data/repos

# ─── Platform ──────────────────────────────────────────────────────────────
PROJECT_NAME=flowamaz
ASPNETCORE_ENVIRONMENT=Development
PLATFORM_BASE_URL=http://localhost:5000

# ─── Frontend ──────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:5000
VITE_APP_NAME=Flowamaz
VITE_HELP_DOCS_URL=https://docs.flowamaz.io

# ─── Email — Transactional (Resend) ────────────────────────────────────────
# Microsoft 365 handles team@, support@, security@ etc.
# Resend handles all application-generated emails (noreply@)
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=noreply@flowamaz.io
EMAIL_FROM_NAME=Flowamaz
SUPPORT_EMAIL=support@flowamaz.io
SECURITY_EMAIL=security@flowamaz.io

# ─── Webhook Delivery ──────────────────────────────────────────────────────
WEBHOOK_SIGNING_SECRET_SALT=
WEBHOOK_DELIVERY_MAX_RETRIES=5

# ─── Metering ──────────────────────────────────────────────────────────────
METERING_ENABLED=true
METERING_BATCH_SIZE=100

# ─── Library Sync (GitHub API) ─────────────────────────────────────────────
GITHUB_CONNECTORS_REPO=flowamaz-io/connectors
GITHUB_TEMPLATES_REPO=flowamaz-io/templates
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
LIBRARY_SYNC_INTERVAL_MINUTES=15

# ─── Community Edition ─────────────────────────────────────────────────────
EDITION=community
COMMUNITY_MAX_WORKFLOWS=5
COMMUNITY_MAX_RUNS_MONTH=500
COMMUNITY_MAX_USERS=1

# ─── Docker ────────────────────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=flowamaz

# ─── Help Docs ─────────────────────────────────────────────────────────────
HELP_DOCS_BASE_URL=https://docs.flowamaz.io
HELP_DOCS_GITHUB_REPO=flowamaz-io/docs
