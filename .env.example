# Flowamaz — environment variable reference (all phases).
# Copy to .env and set real values. Never commit a populated .env.
#
# In Development these may be omitted (sensible defaults / stubs). In every non-Development
# environment the API validates the six variables marked "# REQUIRED" below at startup and
# refuses to boot (with an actionable log line) if any is missing.
#
# Docker note: nested .NET config sections bind via double underscores (Email__ResendApiKey →
# Email:ResendApiKey). Both the flat alias and the section form are accepted where noted.

# ── Database (Postgres) ──────────────────────────────────────────────────────
DB_CONNECTION_STRING=Host=db;Port=5432;Database=flowamaz;Username=flowamaz;Password=change-me  # REQUIRED — Postgres connection string (compose overrides host to db).
DB_NAME=flowamaz                        # Compose Postgres database name.
DB_USER=flowamaz                        # Compose Postgres user.
DB_PASSWORD=change-me                   # Compose Postgres password.

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_CONNECTION_STRING=redis:6379      # Task queue, session/semantic cache, rate limiting (compose overrides to redis:6379).

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me                    # REQUIRED — HMAC key signing access/refresh tokens (>=32 bytes). Gen: openssl rand -base64 48
JWT_ISSUER=flowamaz.io                  # Token issuer claim.
JWT_AUDIENCE=flowamaz-app               # Token audience claim.

# ── Security ─────────────────────────────────────────────────────────────────
CREDENTIAL_MASTER_KEY=change-me         # REQUIRED — credential vault master key (AES-GCM, per-workspace HMAC-derived). Gen: openssl rand -base64 32
GATE_SIGNING_KEY=change-me              # REQUIRED — signs human-gate approval/decline links so they can't be forged. Gen: openssl rand -hex 32

# ── Email (Resend) ───────────────────────────────────────────────────────────
Email__ResendApiKey=re_xxx              # REQUIRED — Resend API key for transactional mail (re_...). Flat alias: RESEND_API_KEY
EMAIL_FROM_ADDRESS=noreply@flowamaz.io  # From address for transactional mail.

# ── AI (Anthropic — only platform-managed provider) ──────────────────────────
Ai__AnthropicPlatformKey=sk-ant-xxx     # REQUIRED — platform Anthropic key (sk-ant-...), powers F1–F7. Flat alias: ANTHROPIC_PLATFORM_KEY
GOOGLE_PLATFORM_KEY=                     # Optional Google AI key (provider-agnostic IAiService; unset = disabled).

# ── Git versioning ───────────────────────────────────────────────────────────
GIT_REPOS_BASE_PATH=/app/data/repos     # Writable base path for per-workspace bare git repos (probed for write access at startup).

# ── Stripe (billing) ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_xxx           # Stripe secret key.
STRIPE_WEBHOOK_SECRET=whsec_xxx         # Stripe webhook signing secret.
STRIPE_STARTER_PRICE_ID_MONTHLY=price_xxx  # Stripe price id — Starter plan, monthly.
STRIPE_STARTER_PRICE_ID_ANNUAL=price_xxx   # Stripe price id — Starter plan, annual.
STRIPE_PRO_PRICE_ID_MONTHLY=price_xxx      # Stripe price id — Pro plan, monthly.
STRIPE_PRO_PRICE_ID_ANNUAL=price_xxx       # Stripe price id — Pro plan, annual.

# ── GitHub (Library connector/template sync) ─────────────────────────────────
GITHUB_CONNECTORS_TOKEN=ghp_xxx         # GitHub token for syncing the connectors/templates Library repos.
GITHUB_CLIENT_ID=                       # GitHub OAuth app client id (sign-in / repo linking).
GITHUB_CLIENT_SECRET=                   # GitHub OAuth app client secret.

# ── OAuth / SSO ──────────────────────────────────────────────────────────────
SLACK_CLIENT_ID=                        # Slack OAuth app client id (connector + gate delivery).
SLACK_CLIENT_SECRET=                    # Slack OAuth app client secret.
SLACK_SIGNING_SECRET=                   # Slack request signing secret (verifies inbound Slack events).
MICROSOFT_CLIENT_ID=                    # Microsoft Entra (SSO) application client id.
MICROSOFT_CLIENT_SECRET=                # Microsoft Entra (SSO) application client secret.
MICROSOFT_TENANT_ID=                    # Microsoft Entra tenant id (or "common" for multi-tenant).

# ── Platform ─────────────────────────────────────────────────────────────────
Platform__BaseUrl=https://app.flowamaz.io  # App base URL (redirect allowlist, generated links). Flat alias: PLATFORM_BASE_URL

# ── Edition ──────────────────────────────────────────────────────────────────
EDITION=community                       # community | starter | pro | enterprise (gates feature limits).

# ── CORS / Marketing ─────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://app.flowamaz.io  # Comma-separated allowed SPA origins (unset in Production blocks all cross-origin).
MARKETING_SITE_URL=https://flowamaz.com       # Marketing site URL for cross-links.

# ── Rate limits ──────────────────────────────────────────────────────────────
Ai__CopilotRateLimitPerHour=60          # Co-pilot (F1) calls per user per hour. Section: Ai:CopilotRateLimitPerHour
Ai__BudgetDefaultMonthlyTokens=500000   # Default per-workspace AI token budget per month (hard cap).
Ai__SemanticCacheTtlHours=24            # Semantic cache TTL in hours.
